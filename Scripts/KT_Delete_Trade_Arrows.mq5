//+------------------------------------------------------------------+
//|                                          Delete_Trade_Arrows.mq4 |
//|                                                Generated by AI   |
//|                          精准删除名称以 # 开头的交易订单箭头          |
//+------------------------------------------------------------------+
#property copyright "K-Target User"
#property link      "https://www.mql5.com"
#property version   "1.00"
#property strict
// 旧代码保留：#property show_inputs // 允许弹出参数窗口
// MQL5脚本会自动显示 input 参数，本脚本没有输入参数，因此不需要该属性。

// ===== 超短速读（3 秒回忆） =====
// 用途：清理图表里的交易箭头与订单轨迹线（仅图表对象，不动真实订单）。
// 规则：对象名以 '#' 开头；轨迹线需含 " -> "；箭头名含 buy/sell/modified。
// 范围：只处理当前图表窗口对象。
// 安全：采用倒序删除，避免删除时索引变化导致漏删。
// 结果：执行统计输出到“专家(Experts)”日志。
// ===============================

//+------------------------------------------------------------------+
//| 脚本说明（仅注释，便于快速回忆）                                  |
//+------------------------------------------------------------------+
//| 一、脚本功能                                                      |
//| 1) 清理图表中的“交易相关标记对象”，主要面向 MT4 自动生成的交易箭头。 |
//| 2) 同时支持删除部分订单轨迹线（形如：#票号 价格 -> 价格）。          |
//| 3) 仅删除符合规则的对象，尽量避免误删用户自定义绘图。               |
//|                                                                  |
//| 二、对象识别规则（当前实现）                                      |
//| 1) 第一层筛选：对象名称必须以 '#' 开头。                           |
//| 2) 轨迹线删除：对象类型为 OBJ_TREND 且名称包含 " -> "。            |
//| 3) 交易箭头删除：名称（转小写后）包含以下关键字之一：               |
//|    - " buy "                                                     |
//|    - " sell "                                                    |
//|    - "modified"                                                  |
//|                                                                  |
//| 三、使用说明                                                      |
//| 1) 将脚本拖放到目标图表执行。                                      |
//| 2) 脚本会自动遍历当前图表对象并按规则删除。                        |
//| 3) 执行结果在“专家(Experts)”日志中查看（删除数量统计）。            |
//|                                                                  |
//| 四、实现要点                                                      |
//| 1) 采用“倒序遍历”删除对象：从最后一个索引往前删，避免索引错位。      |
//| 2) 不依赖订单池，仅处理图表对象层面的可视化标记。                  |
//|                                                                  |
//| 五、注意事项                                                      |
//| 1) 本脚本只作用于当前图表窗口对象，不会修改账户持仓/挂单本身。       |
//| 2) 若你的自定义对象也以 '#' 开头且命名命中关键字，可能被一并删除。   |
//| 3) 建议先在非关键图表测试命名规则，再在常用图表执行。               |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| 脚本主程序
//+------------------------------------------------------------------+
//#region MARK: 模块--MQL5对象类型转换函数
// MQL5转换：ObjectType(name) 改为读取对象的 OBJPROP_TYPE 属性。
int KT_ObjectType(const string object_name)
{
   return((int)ObjectGetInteger(0, object_name, OBJPROP_TYPE));
}
//#endregion

void OnStart()
{
   int total_objects = ObjectsTotal(0, -1, -1); // 获取主图表所有对象
   int deleted_count = 0;
   
   // ⚠️ 必须从后往前遍历，因为删除对象会改变索引
   for(int i = total_objects - 1; i >= 0; i--)
   {
      // 旧代码保留：string obj_name = ObjectName(0, i);
      string obj_name = ObjectName(0, i, -1, -1);
      
      // --- 核心匹配逻辑 ---
      
      // 1. 特征一：名称必须以 '#' 开头 (MT4 订单箭头的铁律)
      // StringFind 返回 0 表示在字符串起始位置找到
      if(StringFind(obj_name, "#") == 0)
      {
         // === 新增功能：删除订单轨迹画线 ===
         // 特征：类型为趋势线 + 名称包含 "->" 模式
         // 示例：#40265328 5213.68 -> 5213.13
         // 旧代码保留：int obj_type = ObjectType(obj_name);
         int obj_type = KT_ObjectType(obj_name);
         if(obj_type == OBJ_TREND && StringFind(obj_name, " -> ") != -1)
         {
            if(ObjectDelete(0, obj_name))
            {
               deleted_count++;
            }
            continue;  // 已处理，跳到下一个对象
         }
         
         // 2. 特征二：名称中包含 "buy"、"sell" 或 "modified" (双重确认，防止误删自定义的 # 标签)
         // StringToLower 将名称转为小写，忽略大小写差异
         string name_lower = obj_name;
         StringToLower(name_lower);
         
         if(StringFind(name_lower, " buy ") != -1 || 
            StringFind(name_lower, " sell ") != -1 || 
            StringFind(name_lower, "modified") != -1)
         {
            // 3. 执行删除
            if(ObjectDelete(0, obj_name))
            {
               deleted_count++;
            }
         }
         // 特殊情况：如果您想删除所有 # 开头的对象，
         // 可以把上面的 if(StringFind...) 注释掉，
         // 只保留 if(StringFind(obj_name, "#") == 0) 这一层判断。
      }
   }
   
   // 打印结果到“专家”选项卡
   Print("════════════════════════════════════════════");
   Print(" 交易标记清理完成！");
   Print("────────────────────────────────────────────");
   Print(" 共删除: ", deleted_count, " 个对象");
   Print("   └─ 包含订单轨迹线和交易箭头");
   Print("════════════════════════════════════════════");
   // Comment("已清理 ", deleted_count, " 个交易箭头。");
   // Sleep(1000);
   // Comment(""); // 清除注释
}
//+------------------------------------------------------------------+