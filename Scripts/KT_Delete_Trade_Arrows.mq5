#property copyright "K-Target User"
#property link      "https://www.mql5.com"
#property version   "1.00"
#property strict
// 旧代码保留：#property show_inputs // 允许弹出参数窗口
// MQL5脚本会自动显示 input 参数，本脚本没有输入参数，因此不需要该属性。

// ===== 超短速读（3 秒回忆） =====
// 用途：清理图表里的交易箭头与订单轨迹线（仅图表对象，不动真实订单）。
// 规则：对象名含订单号（#数字）；轨迹线含 " -> "；箭头名含 buy/sell/modified。
// 范围：只处理当前图表窗口对象。
// 安全：采用倒序删除，避免删除时索引变化导致漏删。
// 结果：执行统计输出到“专家(Experts)”日志。
// ===============================

//+------------------------------------------------------------------+
//| 脚本说明（仅注释，便于快速回忆）                                  |
//+------------------------------------------------------------------+
//| 一、脚本功能                                                      |
//| 1) 清理图表中的“交易相关标记对象”，主要面向 MT4 自动生成的交易箭头。 |
//| 2) 同时支持删除部分订单轨迹线（形如：#票号 价格 -> 价格）。          |
//| 3) 仅删除符合规则的对象，尽量避免误删用户自定义绘图。               |
//|                                                                  |
//| 二、对象识别规则（当前实现）                                      |
//| 1) 第一层筛选：对象名称必须包含 '#' 后紧跟数字的订单号。            |
//| 2) 轨迹线删除：名称包含 " -> "，不依赖终端返回的对象类型。          |
//| 3) 交易箭头删除：名称（转小写后）包含以下关键字之一：               |
//|    - " buy "                                                     |
//|    - " sell "                                                    |
//|    - "modified"                                                  |
//|                                                                  |
//| 三、使用说明                                                      |
//| 1) 将脚本拖放到目标图表执行。                                      |
//| 2) 脚本会自动遍历当前图表对象并按规则删除。                        |
//| 3) 执行结果在“专家(Experts)”日志中查看（删除数量统计）。            |
//|                                                                  |
//| 四、实现要点                                                      |
//| 1) 采用“倒序遍历”删除对象：从最后一个索引往前删，避免索引错位。      |
//| 2) 不依赖订单池，仅处理图表对象层面的可视化标记。                  |
//|                                                                  |
//| 五、注意事项                                                      |
//| 1) 本脚本只作用于当前图表窗口对象，不会修改账户持仓/挂单本身。       |
//| 2) 若你的自定义对象含有“#数字”及上述交易关键字，可能被一并删除。  |
//| 3) 建议先在非关键图表测试命名规则，再在常用图表执行。               |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| 脚本主程序
//+------------------------------------------------------------------+

bool KT_HasTicketMarker(const string object_name)
{
   int ticket_marker = StringFind(object_name, "#");
   while(ticket_marker >= 0)
   {
      int next_char = ticket_marker + 1;
      if(next_char < StringLen(object_name))
      {
         ushort first_digit = StringGetCharacter(object_name, next_char);
         if(first_digit >= '0' && first_digit <= '9')
            return(true);
      }

      int next_marker = StringFind(object_name, "#", ticket_marker + 1);
      if(next_marker < 0)
         break;
      ticket_marker = next_marker;
   }
   return(false);
}

bool KT_IsTradeMarker(const string object_name, const int object_type)
{
   if(!KT_HasTicketMarker(object_name))
      return(false);

   // MT5 交易轨迹通常是 OBJ_ARROW 或 OBJ_TREND。
   // 对这两类对象只检查订单号，避免因终端/插件文本格式不同而漏删。
   if(object_type == OBJ_ARROW ||
      object_type == OBJ_ARROW_BUY ||
      object_type == OBJ_ARROW_SELL ||
      object_type == OBJ_TREND)
      return(true);

   string name_lower = object_name;
   StringToLower(name_lower);

   return(StringFind(name_lower, " -> ") >= 0 ||
          StringFind(name_lower, " buy ") >= 0 ||
          StringFind(name_lower, " sell ") >= 0 ||
          StringFind(name_lower, "modified") >= 0 ||
          StringFind(name_lower, ", tp,") >= 0);
}

void OnStart()
{
   int total_objects = ObjectsTotal(0, -1, -1); // 获取主图表所有对象
   int deleted_count = 0;
   
   // ⚠️ 必须从后往前遍历，因为删除对象会改变索引
   for(int i = total_objects - 1; i >= 0; i--)
   {
      // 旧代码保留：string obj_name = ObjectName(0, i);
      string obj_name = ObjectName(0, i, -1, -1);
      int obj_type = (int)ObjectGetInteger(0, obj_name, OBJPROP_TYPE);
      
      // --- 核心匹配逻辑 ---
      
      // 1. MT5 的对象名称可能带有前缀，例如：
      //    autotrade #174000265 buy 0.1 XAUUSD at 4001.85, XAUUSD
      // 因此不能要求 '#' 位于名称首字符。
      if(KT_IsTradeMarker(obj_name, obj_type))
      {
         ResetLastError();
         if(ObjectDelete(0, obj_name))
         {
            deleted_count++;
         }
         else
         {
            Print("删除对象失败: name=", obj_name,
                  ", type=", obj_type,
                  ", error=", GetLastError());
         }
      }
   }
   
   // 打印结果到“专家”选项卡
   Print("════════════════════════════════════════════");
   Print(" 交易标记清理完成！");
   Print("────────────────────────────────────────────");
   Print(" 共删除: ", deleted_count, " 个对象");
   Print("   └─ 包含订单轨迹线和交易箭头");
   Print("════════════════════════════════════════════");
   // Comment("已清理 ", deleted_count, " 个交易箭头。");
   // Sleep(1000);
   // Comment(""); // 清除注释
}
